{
  "name": "ferrofluid-visualizer",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node electron/generate-icons.cjs && node electron/make-ico.cjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "dist": "npm run electron:build"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ferrofluid.visualizer",
    "productName": "Ferrofluid Visualizer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "electron/icon.ico"
    },
    "portable": {
      "unpackDirName": "FerrofluidVisualizer"
    }
  }
}
